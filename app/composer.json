{
    "name": "reproducer/symfony-frankenphp-terminate",
    "description": "kernel.terminate loses the request body and uploaded files under the FrankenPHP worker runner",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/cache": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
